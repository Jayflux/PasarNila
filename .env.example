# Salin menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.
# Rincian setiap variabel: ARCHITECTURE.md §15. Periksa dengan: npm run check:env
# (laporan hanya berisi nama & status, tanpa nilai; tidak memeriksa koneksi database).

# --- Aplikasi -----------------------------------------------------------------------------
# URL proyek Supabase (origin saja, tanpa path). Lokal: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key baru (sb_publishable_...). JANGAN isi anon key lama atau secret key (sb_secret_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<isi-dari-dashboard>
# URL kanonik situs (origin saja). Wajib di production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Nomor WhatsApp format 62... (lihat PRD BR-WA5). Kosong = tombol WhatsApp nonaktif, tanpa nomor cadangan.
WHATSAPP_NUMBER=
# "true" hanya saat peluncuran. Selain itu seluruh situs noindex.
ALLOW_INDEXING=false

# --- Tooling lokal/CI saja (JANGAN diset di Vercel) ----------------------------------------
# Catatan: untuk Next.js dan Supabase CLI, variabel yang sudah ada di environment sistem mengalahkan
# nilai di file ini. Skrip uji/preflight database membaca file ini SAJA (bukan environment sistem).
# Ref proyek dev/staging (20 huruf kecil), harus sama dengan host NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_PROJECT_REF=
# Peruntukan proyek di atas: development | staging | production.
# Migrasi & uji database dari laptop hanya berjalan untuk development/staging.
SUPABASE_TARGET_ENV=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Connection string untuk uji SQL langsung (npm run test:db:cloud). Berisi password: rahasia.
# Contoh bentuk (session pooler): postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
SUPABASE_DB_URL=
# Path sertifikat CA Supabase (Dashboard → Database → SSL) bila verifikasi TLS memerlukannya.
SUPABASE_DB_CA_PATH=
# Akun uji di proyek dev/staging saja. Mitra dan outsider harus akun berbeda.
E2E_PARTNER_EMAIL=
E2E_PARTNER_PASSWORD=
E2E_OUTSIDER_EMAIL=
E2E_OUTSIDER_PASSWORD=

# --- Tidak dipakai aplikasi dan TIDAK BOLEH diset -----------------------------------------
# SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY
